---
import '../styles/global.css';
import '../styles/reservas.css';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Reservá tu turno en After Look. Cortes precisos y barbería premium." />
    <title>Reservar Turno / After Look</title>
  </head>
  <body class="reservas-page">
    <main class="reservas-shell" aria-labelledby="servicio-title">
      <!-- Panel visual izquierdo -->
      <section class="reservas-photo-card" aria-labelledby="servicio-title">
        <nav class="reservas-topbar" aria-label="Navegación de reserva">
          <div class="client-avatar-badge" id="client-avatar" aria-label="Perfil del cliente" title="Perfil del cliente">
            <span id="client-avatar-initials">CL</span>
          </div>
          <a class="reservas-home" href="/" aria-label="After Look">After Look</a>
          <div class="user-session-bar">
            <span id="user-display" class="client-name-display"></span>
            <button id="logout-btn" type="button" class="client-logout-btn">Salir</button>
          </div>
        </nav>

        <figure class="service-figure">
          <img id="service-hero-img" src="/images/service-beard.png" alt="Servicio en el salón After Look" />
        </figure>

        <div class="service-overview">
          <div class="service-summary">
            <h1 id="servicio-title">Turnos Online</h1>
            <p id="servicio-desc">Elegí tu servicio, profesional y horario ideal.</p>
          </div>
          <ul class="service-meta" aria-label="Detalles del servicio seleccionado">
            <li>
              <span aria-hidden="true">⏱</span>
              <span id="service-duration-label">60 minutos</span>
            </li>
            <li>
              <span aria-hidden="true">✦</span>
              <span>Atención en salón</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Panel interactivo de reserva derecho -->
      <section class="booking-panel" aria-labelledby="seleccion-title">
        <div class="booking-panel-header">
          <p class="reservas-kicker">Agenda tu cita</p>
          <h2 id="seleccion-title">Armá tu reserva</h2>
          <p>Seleccioná cada paso para confirmar tu turno en tiempo real.</p>
        </div>

        <!-- 1. Selección de servicio -->
        <section class="choice-section" aria-labelledby="servicio-choice-title">
          <h3 id="servicio-choice-title">1. Elegí servicio</h3>
          <div id="services-list" class="service-list" role="list">
            <div style="color: rgba(255,250,241,0.5); font-size: 13px;">Cargando servicios disponibles...</div>
          </div>
        </section>

        <!-- 2. Selección de peluquero -->
        <section class="choice-section" aria-labelledby="peluquero-title">
          <h3 id="peluquero-title">2. Elegí profesional</h3>
          <div id="stylists-list" class="stylist-list" role="list">
            <div style="color: rgba(255,250,241,0.5); font-size: 13px;">Cargando estilistas disponibles...</div>
          </div>
        </section>

        <!-- 3. Selección de fecha -->
        <section class="choice-section" aria-labelledby="fecha-title">
          <div class="section-heading-row">
            <h3 id="fecha-title">3. Elegí fecha</h3>
            <span id="month-indicator">Próximos días</span>
          </div>
          <div id="date-strip" class="date-strip" role="list"></div>
        </section>

        <!-- 4. Selección de horario -->
        <section class="choice-section" aria-labelledby="horario-title">
          <div class="section-heading-row">
            <h3 id="horario-title">4. Elegí horario</h3>
            <span id="slots-count-label"></span>
          </div>
          <div id="time-grid" class="time-grid" role="list">
            <div style="grid-column: 1 / -1; color: rgba(255,250,241,0.5); font-size: 13px; text-align: center; padding: 12px;">
              Seleccioná un profesional y una fecha para ver horarios disponibles.
            </div>
          </div>
        </section>

        <!-- 5. Notas opcionales -->
        <section class="choice-section booking-notes-box">
          <label for="booking-notes" style="font-size: 13px; font-weight: 700; color: rgba(255,250,241,0.7);">
            Notas o indicaciones para el salón (opcional)
          </label>
          <textarea
            id="booking-notes"
            class="booking-notes-input"
            placeholder="Ej: Corte con degradé bajo, arreglo de cejas, etc."
            maxlength="500"
          ></textarea>
        </section>

        <!-- 6. Resumen y Confirmación -->
        <div class="booking-action">
          <div id="booking-summary-strip" class="booking-summary-strip" style="display: none;">
            <div><span id="summary-service-text"></span> con <strong id="summary-stylist-text"></strong></div>
            <div><span id="summary-date-text"></span> a las <strong id="summary-time-text"></strong></div>
          </div>

          <button id="confirm-booking-btn" class="booking-cta" type="button" disabled aria-disabled="true">
            Confirmar turno
          </button>
          <p id="booking-status-note">Completá todos los pasos para confirmar tu turno.</p>
        </div>
      </section>
    </main>

    <!-- Modal de confirmación exitosa -->
    <div id="confirmation-modal" class="booking-modal-overlay" style="display: none;">
      <div class="booking-modal-card">
        <div class="modal-icon-badge">✓</div>
        <h2 class="modal-title">¡Turno Confirmado!</h2>
        <p class="modal-lede">Tu reserva fue agendada con éxito. Te esperamos puntualmente en el salón.</p>

        <div class="modal-details-list">
          <div class="modal-detail-row">
            <span>N° de Reserva:</span>
            <strong id="modal-booking-id">#</strong>
          </div>
          <div class="modal-detail-row">
            <span>Servicio:</span>
            <strong id="modal-booking-service">-</strong>
          </div>
          <div class="modal-detail-row">
            <span>Profesional:</span>
            <strong id="modal-booking-stylist">-</strong>
          </div>
          <div class="modal-detail-row">
            <span>Fecha y Hora:</span>
            <strong id="modal-booking-datetime">-</strong>
          </div>
          <div class="modal-detail-row">
            <span>Estado:</span>
            <strong style="color: #4ade80;">CONFIRMADA</strong>
          </div>
        </div>

        <div class="modal-actions">
          <button id="modal-new-booking-btn" class="modal-btn-primary" type="button">
            Agendar otro turno
          </button>
          <a href="/" class="modal-btn-secondary" style="text-decoration: none; display: grid; place-items: center;">
            Volver al inicio
          </a>
        </div>
      </div>
    </div>

    <script>
      interface ServiceItem {
        id: number;
        nombre: string;
        descripcion?: string;
        tipo_servicio: string;
        duracion_minutos: number;
        precio_base: string;
      }

      interface StylistItem {
        id: number;
        nombre_completo: string;
        email_google: string;
      }

      interface TimeSlot {
        hora: string;
        disponible: boolean;
      }

      // App state
      let selectedService: ServiceItem | null = null;
      let selectedStylist: StylistItem | null = null;
      let selectedDateStr: string = "";
      let selectedTimeStr: string = "";

      let allServices: ServiceItem[] = [];
      let allStylists: StylistItem[] = [];

      const DAYS_NAME = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
      const MONTHS_NAME = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

      function getInitials(name: string): string {
        if (!name) return "CL";
        const parts = name.trim().split(/\s+/);
        if (parts.length >= 2) {
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        }
        return name.slice(0, 2).toUpperCase();
      }

      async function initPage() {
        const avatarEl = document.getElementById("client-avatar");
        const avatarInitialsEl = document.getElementById("client-avatar-initials");
        const userDisplay = document.getElementById("user-display");
        const logoutBtn = document.getElementById("logout-btn");
        const statusNote = document.getElementById("booking-status-note");

        // 1. Session check
        try {
          const res = await fetch("/auth/me");
          if (!res.ok) {
            window.location.href = "/registro/";
            return;
          }
          const user = await res.json();
          if (!user.profile_complete) {
            window.location.href = "/completar-perfil/";
            return;
          }

          if (userDisplay) {
            userDisplay.textContent = user.nombre;
            userDisplay.title = user.nombre;
          }
          if (avatarInitialsEl) {
            avatarInitialsEl.textContent = getInitials(user.nombre);
          }
          if (avatarEl) {
            avatarEl.setAttribute("title", user.nombre);
          }
          if (logoutBtn) {
            logoutBtn.style.display = "inline-block";
            logoutBtn.addEventListener("click", async () => {
              await fetch("/auth/logout", { method: "POST" });
              window.location.href = "/";
            });
          }
        } catch {
          window.location.href = "/registro/";
          return;
        }

        // 2. Load services and hairdressers in parallel
        try {
          const [servicesRes, stylistsRes] = await Promise.all([
            fetch("/api/booking/services"),
            fetch("/api/booking/hairdressers"),
          ]);

          if (servicesRes.ok && stylistsRes.ok) {
            allServices = await servicesRes.json();
            allStylists = await stylistsRes.json();

            renderServices();
            renderStylists();
            renderDateStrip();
          } else {
            if (statusNote) {
              statusNote.textContent = "Error al cargar catálogo de servicios.";
              statusNote.style.color = "#ff6b6b";
            }
          }
        } catch {
          if (statusNote) {
            statusNote.textContent = "Error de conexión con el salón.";
            statusNote.style.color = "#ff6b6b";
          }
        }

        setupConfirmationFlow();
      }

      function renderServices() {
        const container = document.getElementById("services-list");
        if (!container) return;

        container.innerHTML = "";
        allServices.forEach((service, index) => {
          const card = document.createElement("div");
          card.className = `service-card ${index === 0 ? "is-selected" : ""}`;
          card.setAttribute("role", "listitem");
          card.setAttribute("tabindex", "0");

          const icon = service.tipo_servicio === "BARBERIA" ? "✂" : "✦";

          card.innerHTML = `
            <div class="service-card-icon">${icon}</div>
            <div class="service-card-info">
              <span class="service-card-title">${service.nombre}</span>
              <span class="service-card-meta">${service.duracion_minutos} min · ${service.descripcion || "Atención personalizada"}</span>
            </div>
          `;

          card.addEventListener("click", () => {
            document.querySelectorAll(".service-card").forEach((c) => c.classList.remove("is-selected"));
            card.classList.add("is-selected");
            selectedService = service;
            updateHeroImage(service);
            updateSummary();
            fetchAvailability();
          });

          container.appendChild(card);
        });

        if (allServices.length > 0) {
          selectedService = allServices[0];
          updateHeroImage(allServices[0]);
        }
      }

      function updateHeroImage(service: ServiceItem) {
        const heroImg = document.getElementById("service-hero-img") as HTMLImageElement | null;
        const durationLabel = document.getElementById("service-duration-label");
        const titleEl = document.getElementById("servicio-title");
        const descEl = document.getElementById("servicio-desc");

        if (heroImg) {
          heroImg.src = service.tipo_servicio === "BARBERIA" ? "/images/service-beard.png" : "/images/hero-barber.png";
        }
        if (durationLabel) {
          durationLabel.textContent = `${service.duracion_minutos} minutos`;
        }
        if (titleEl) {
          titleEl.textContent = service.nombre;
        }
        if (descEl) {
          descEl.textContent = service.descripcion || "Cortes precisos que combinan con tu estilo personal.";
        }
      }

      function renderStylists() {
        const container = document.getElementById("stylists-list");
        if (!container) return;

        container.innerHTML = "";
        allStylists.forEach((stylist, index) => {
          const card = document.createElement("div");
          card.className = `stylist-card ${index === 0 ? "is-selected" : ""}`;
          card.setAttribute("role", "listitem");
          card.setAttribute("tabindex", "0");

          // Initials
          const initials = stylist.nombre_completo
            .split(" ")
            .map((n) => n[0])
            .join("")
            .slice(0, 2)
            .toUpperCase();

          card.innerHTML = `
            <span class="stylist-avatar">${initials}</span>
            <span>${stylist.nombre_completo}</span>
          `;

          card.addEventListener("click", () => {
            document.querySelectorAll(".stylist-card").forEach((c) => c.classList.remove("is-selected"));
            card.classList.add("is-selected");
            selectedStylist = stylist;
            updateSummary();
            fetchAvailability();
          });

          container.appendChild(card);
        });

        if (allStylists.length > 0) {
          selectedStylist = allStylists[0];
        }
      }

      function renderDateStrip() {
        const container = document.getElementById("date-strip");
        if (!container) return;

        container.innerHTML = "";
        const today = new Date();
        const candidateDates: Date[] = [];

        // Generate next 14 days, skip Sundays (day === 0)
        let checkDate = new Date(today);
        while (candidateDates.length < 6) {
          if (checkDate.getDay() !== 0) {
            candidateDates.push(new Date(checkDate));
          }
          checkDate.setDate(checkDate.getDate() + 1);
        }

        candidateDates.forEach((dateObj, idx) => {
          const chip = document.createElement("div");
          chip.className = `date-chip ${idx === 0 ? "is-selected" : ""}`;
          chip.setAttribute("role", "listitem");
          chip.setAttribute("tabindex", "0");

          const dayIndex = (dateObj.getDay() + 6) % 7; // Monday=0 ... Sunday=6
          const dayName = DAYS_NAME[dayIndex];
          const dayNum = dateObj.getDate().toString().padStart(2, "0");
          const isoDate = dateObj.toISOString().split("T")[0];

          chip.innerHTML = `
            <span>${dayName}</span>
            <strong>${dayNum}</strong>
          `;

          chip.addEventListener("click", () => {
            document.querySelectorAll(".date-chip").forEach((c) => c.classList.remove("is-selected"));
            chip.classList.add("is-selected");
            selectedDateStr = isoDate;
            updateSummary();
            fetchAvailability();
          });

          container.appendChild(chip);
        });

        if (candidateDates.length > 0) {
          selectedDateStr = candidateDates[0].toISOString().split("T")[0];
          updateSummary();
          fetchAvailability();
        }
      }

      async function fetchAvailability() {
        if (!selectedStylist || !selectedDateStr) return;

        const timeGrid = document.getElementById("time-grid");
        const slotsCountLabel = document.getElementById("slots-count-label");
        const confirmBtn = document.getElementById("confirm-booking-btn") as HTMLButtonElement | null;
        selectedTimeStr = "";
        updateSummary();

        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.setAttribute("aria-disabled", "true");
        }

        if (timeGrid) {
          timeGrid.innerHTML = `
            <div style="grid-column: 1 / -1; color: rgba(255,250,241,0.5); font-size: 13px; text-align: center; padding: 12px;">
              Buscando horarios disponibles...
            </div>
          `;
        }

        try {
          const dur = selectedService ? selectedService.duracion_minutos : 60;
          const url = `/api/booking/availability?peluquero_id=${selectedStylist.id}&fecha=${selectedDateStr}&duracion_minutos=${dur}`;
          const res = await fetch(url);

          if (!res.ok) {
            if (timeGrid) timeGrid.innerHTML = `<div style="grid-column: 1 / -1; color: #ff6b6b; font-size: 13px; text-align: center;">No pudimos cargar los horarios.</div>`;
            return;
          }

          const data = await res.json();
          const slots: TimeSlot[] = data.slots || [];

          if (slots.length === 0) {
            if (timeGrid) {
              timeGrid.innerHTML = `
                <div style="grid-column: 1 / -1; color: rgba(255,250,241,0.6); font-size: 13px; text-align: center; padding: 16px;">
                  El salón o el profesional no tienen disponibilidad en esta fecha. Elegí otro día.
                </div>
              `;
            }
            if (slotsCountLabel) slotsCountLabel.textContent = "Cerrado";
            return;
          }

          const availableCount = slots.filter((s) => s.disponible).length;
          if (slotsCountLabel) {
            slotsCountLabel.textContent = `${availableCount} disponibles`;
          }

          if (timeGrid) {
            timeGrid.innerHTML = "";
            slots.forEach((slot) => {
              const pill = document.createElement("span");
              pill.className = `time-pill ${!slot.disponible ? "is-muted" : ""}`;
              pill.setAttribute("role", "listitem");
              pill.textContent = slot.hora;

              if (slot.disponible) {
                pill.setAttribute("tabindex", "0");
                pill.addEventListener("click", () => {
                  document.querySelectorAll(".time-pill").forEach((p) => p.classList.remove("is-selected"));
                  pill.classList.add("is-selected");
                  selectedTimeStr = slot.hora;
                  updateSummary();

                  if (confirmBtn) {
                    confirmBtn.disabled = false;
                    confirmBtn.removeAttribute("aria-disabled");
                  }
                });
              } else {
                pill.setAttribute("aria-disabled", "true");
                pill.title = "Horario no disponible o ya reservado";
              }

              timeGrid.appendChild(pill);
            });
          }
        } catch {
          if (timeGrid) {
            timeGrid.innerHTML = `<div style="grid-column: 1 / -1; color: #ff6b6b; font-size: 13px; text-align: center;">Error al consultar disponibilidad.</div>`;
          }
        }
      }

      function updateSummary() {
        const summaryStrip = document.getElementById("booking-summary-strip");
        const serviceText = document.getElementById("summary-service-text");
        const stylistText = document.getElementById("summary-stylist-text");
        const dateText = document.getElementById("summary-date-text");
        const timeText = document.getElementById("summary-time-text");
        const statusNote = document.getElementById("booking-status-note");

        if (!selectedService || !selectedStylist || !selectedDateStr) {
          if (summaryStrip) summaryStrip.style.display = "none";
          return;
        }

        if (summaryStrip) summaryStrip.style.display = "flex";
        if (serviceText) serviceText.textContent = selectedService.nombre;
        if (stylistText) stylistText.textContent = selectedStylist.nombre_completo;

        // Date pretty format
        const [y, m, d] = selectedDateStr.split("-");
        const dateFormatted = `${d}/${m}/${y}`;
        if (dateText) dateText.textContent = dateFormatted;

        if (selectedTimeStr) {
          if (timeText) timeText.textContent = `${selectedTimeStr} hs`;
          if (statusNote) {
            statusNote.textContent = "Todo listo para reservar. Hacé clic en Confirmar turno.";
            statusNote.style.color = "#4ade80";
          }
        } else {
          if (timeText) timeText.textContent = "Seleccioná horario";
          if (statusNote) {
            statusNote.textContent = "Seleccioná un horario disponible de la lista.";
            statusNote.style.color = "rgba(255,250,241,0.6)";
          }
        }
      }

      function setupConfirmationFlow() {
        const confirmBtn = document.getElementById("confirm-booking-btn") as HTMLButtonElement | null;
        const notesInput = document.getElementById("booking-notes") as HTMLTextAreaElement | null;
        const statusNote = document.getElementById("booking-status-note");

        const modal = document.getElementById("confirmation-modal");
        const modalBookingId = document.getElementById("modal-booking-id");
        const modalBookingService = document.getElementById("modal-booking-service");
        const modalBookingStylist = document.getElementById("modal-booking-stylist");
        const modalBookingDatetime = document.getElementById("modal-booking-datetime");
        const modalNewBookingBtn = document.getElementById("modal-new-booking-btn");

        if (confirmBtn) {
          confirmBtn.addEventListener("click", async () => {
            if (!selectedService || !selectedStylist || !selectedDateStr || !selectedTimeStr) {
              return;
            }

            confirmBtn.disabled = true;
            confirmBtn.textContent = "Confirmando tu turno...";
            if (statusNote) {
              statusNote.textContent = "Procesando reserva...";
              statusNote.style.color = "#38bdf8";
            }

            try {
              const res = await fetch("/api/booking/reserve", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  servicio_id: selectedService.id,
                  peluquero_id: selectedStylist.id,
                  fecha: selectedDateStr,
                  hora: selectedTimeStr,
                  notas_cliente: notesInput ? notesInput.value.trim() : null,
                }),
              });

              if (res.ok) {
                const booking = await res.json();

                // Fill modal
                if (modalBookingId) modalBookingId.textContent = `#${booking.id}`;
                if (modalBookingService) modalBookingService.textContent = booking.servicio_nombre;
                if (modalBookingStylist) modalBookingStylist.textContent = booking.peluquero_nombre;
                if (modalBookingDatetime) {
                  const [y, m, d] = selectedDateStr.split("-");
                  modalBookingDatetime.textContent = `${d}/${m}/${y} — ${selectedTimeStr} hs`;
                }

                if (modal) modal.style.display = "grid";

                if (statusNote) {
                  statusNote.textContent = "¡Turno confirmado con éxito!";
                  statusNote.style.color = "#4ade80";
                }
              } else {
                const errData = await res.json().catch(() => ({}));
                const msg = errData?.error?.message || errData?.detail || "No se pudo confirmar el turno. Intentá con otro horario.";

                if (statusNote) {
                  statusNote.textContent = typeof msg === "string" ? msg : "El turno ya no está disponible.";
                  statusNote.style.color = "#ff6b6b";
                }

                // Refresh slots
                fetchAvailability();
              }
            } catch {
              if (statusNote) {
                statusNote.textContent = "Error de conexión al enviar la reserva.";
                statusNote.style.color = "#ff6b6b";
              }
            } finally {
              confirmBtn.textContent = "Confirmar turno";
              if (selectedTimeStr) {
                confirmBtn.disabled = false;
              }
            }
          });
        }

        if (modalNewBookingBtn && modal) {
          modalNewBookingBtn.addEventListener("click", () => {
            modal.style.display = "none";
            if (notesInput) notesInput.value = "";
            fetchAvailability();
          });
        }
      }

      initPage();
    </script>
  </body>
</html>
