APP_NAME=After Look
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@localhost:5432/afterlook
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
SECRET_KEY=replace-this-value
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_HAIRDRESSER_1_NAME=Hairdresser One
SEED_HAIRDRESSER_1_EMAIL=hairdresser1@example.com
SEED_HAIRDRESSER_2_NAME=Hairdresser Two
SEED_HAIRDRESSER_2_EMAIL=hairdresser2@example.com
SEED_HAIRDRESSER_3_NAME=Hairdresser Three
SEED_HAIRDRESSER_3_EMAIL=hairdresser3@example.com

# Google OAuth configuration
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret-client
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SESSION_COOKIE_NAME=afterlook_session
SESSION_TTL_MINUTES=480
